[_tb_end_text]

[tb_start_text mode=1 ]
#Kupyadoel
But spirits usually need a partner if they want a steady supply of mana.[p]
[_tb_end_text]

[chara_mod  name="劇場える"  time="0"  cross="false"  storage="chara/16/kupya7.png"  ]
[tb_start_text mode=1 ]
